{% set ns = namespace(prefix="/usr/bin/swaync") %}
{% if ansible_facts.hostname == "hbuyse-promax14" %}
{% set ns.prefix = "/usr/local/bin" %}
{% endif %}

[Unit]
Description=Swaync notification daemon
Documentation=https://github.com/ErikReider/SwayNotificationCenter
PartOf=sway-session.target
After=sway-session.target
# ConditionEnvironment requires systemd v247 to work correctly
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=dbus
BusName=org.freedesktop.Notifications
{% if swaync_current_version.split('.') | map('int') | list >= [0, 12, 0] %}
ExecStart={{ ns.prefix }}/swaync --skip-system-css
{% else %}
ExecStart={{ ns.prefix }}/swaync
{% endif %}
ExecReload={{ ns.prefix }}/swaync-client --reload-config ; {{ ns.prefix }}/swaync-client --reload-css
Restart=on-failure
RestartSec=5

[Install]
WantedBy=sway-session.target
