{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["pre-commit", "ansible-galaxy", "pip_requirements", "github-actions", "custom.regex"],
  "timezone": "Europe/Paris",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "One pull request for all the pre-commit hooks",
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit hooks"
    },
    {
      "description": "One pull request for the Python packages used to run the tests",
      "matchManagers": ["pip_requirements"],
      "groupName": "test tools"
    },
    {
      "description": "One pull request for the container images of the Molecule scenarios, pinned by digest",
      "matchDatasources": ["docker"],
      "matchFileNames": ["roles/*/molecule/**"],
      "groupName": "Molecule images",
      "pinDigests": true
    },
    {
      "description": "The crates are pinned to an exact version: with the cargo versioning, Renovate reads it as a caret requirement and writes the lowest version of the new range",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["crate"],
      "versioning": "semver"
    },
    {
      "description": "Perl::Tidy is versioned by date (20260826): do not take the difference between two dates for a huge major increment",
      "matchDepNames": ["Perl::Tidy"],
      "maxMajorIncrement": 0
    },
    {
      "description": "Wait three days after the release of a version before updating to it (not for the digests of the images, which have no release date)",
      "matchUpdateTypes": ["major", "minor", "patch"],
      "minimumReleaseAge": "3 days",
      "internalChecksFilter": "strict"
    },
    {
      "description": "Merge the pull requests by themselves, except the major updates which may break a role",
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "automerge": true
    },
    {
      "description": "ansible-core 2.21 does not start on Python 3.15 (dataclasses._is_type is gone): stay on 3.13 and 3.14",
      "matchDepNames": ["python"],
      "allowedVersions": "<3.15"
    },
    {
      "description": "Only the even major versions of Node.js are long term support releases",
      "matchDepNames": ["node"],
      "allowedVersions": "/^\\d*[02468]$/"
    }
  ],
  "customManagers": [
    {
      "description": "Images of the Molecule scenarios",
      "customType": "regex",
      "fileMatch": ["^roles/[^/]+/molecule/[^/]+/molecule\\.yml$"],
      "matchStrings": ["image: (?<depName>[^:\\s]+):(?<currentValue>[^\\s@]+)(@(?<currentDigest>sha256:[a-f0-9]+))?"],
      "datasourceTemplate": "docker"
    },
    {
      "description": "Plugins of tmux, pinned by tag in the tmux role",
      "customType": "regex",
      "fileMatch": ["^roles/tmux/tasks/main\\.yml$"],
      "matchStrings": [
        "repo: \"https://github\\.com/(?<depName>[^\"]+)\"\\s+plugin_dir: \"[^\"]+\"\\s+version: \"(?<currentValue>v[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "description": "Version of the Catppuccin theme written in tmux.conf, like in the tmux role (the same pull request updates both)",
      "customType": "regex",
      "fileMatch": ["^roles/tmux/files/tmux\\.conf$"],
      "matchStrings": ["@plugin '(?<depName>catppuccin/tmux)#(?<currentValue>v[^']+)'"],
      "datasourceTemplate": "github-tags"
    },
    {
      "description": "Major version of Node.js installed on Debian family",
      "customType": "regex",
      "fileMatch": ["^roles/nodejs/vars/debian\\.yml$"],
      "matchStrings": ["nodejs_version: (?<currentValue>\\d+)"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    },
    {
      "description": "Packages of cargo, npm, pipx, pip, cpanm and go pinned in the roles, with a `# renovate: datasource=... depName=...` comment above the version",
      "customType": "regex",
      "fileMatch": ["^roles/[^/]+/(tasks|defaults)/[^/]+\\.ya?ml$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\n\\s*(?:\\w+_)?version: \"(?<currentValue>[^\"\\s]+)\"",
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\n\\s*(?:- |name: )\"[^\"=\\s]+==(?<currentValue>[^\"\\s]+)\""
      ]
    }
  ]
}
